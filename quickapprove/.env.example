# LaunchDarkly server-side SDK key (Test environment to start).
# Get it from: app.launchdarkly.com -> your project -> Settings -> SDK keys -> [environment] -> SDK key
LAUNCHDARKLY_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# LaunchDarkly flag key this app evaluates. Must match exactly what you create in the LD UI.
LD_FLAG_KEY=instant-approval

# Port the Flask dev server runs on.
PORT=5050

# Observe: set to "off" to run without the LaunchDarkly observability plugin.
LD_OBSERVABILITY=on

# Optional. Shown as the service version in LaunchDarkly Observability. A git SHA is best.
APP_VERSION=demo
